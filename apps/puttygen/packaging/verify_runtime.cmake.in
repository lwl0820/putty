# 对 Qt 部署结果做硬检查，缺少平台插件时不生成看似可用的包。
set(_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
if(NOT EXISTS "${_root}/translations/qtbase_zh_CN.qm")
    message(FATAL_ERROR "发布包缺少 Qt 中文标准控件翻译：qtbase_zh_CN.qm")
endif()
if(WIN32)
    foreach(_required Qt6Core.dll Qt6Gui.dll Qt6Widgets.dll plugins/platforms/qwindows.dll)
        if(NOT EXISTS "${_root}/@CMAKE_INSTALL_BINDIR@/${_required}" AND
           NOT EXISTS "${_root}/${_required}")
            message(FATAL_ERROR "Windows 发布依赖缺失：${_required}")
        endif()
    endforeach()
    file(GLOB _crt "${_root}/@CMAKE_INSTALL_BINDIR@/vcruntime140*.dll")
    if(NOT _crt)
        message(FATAL_ERROR "Windows 发布包缺少应用本地 MSVC 运行库")
    endif()
else()
    file(GLOB_RECURSE _xcb "${_root}/*libqxcb.so")
    file(GLOB_RECURSE _wayland "${_root}/*libqwayland-generic.so")
    if(NOT _xcb OR NOT _wayland)
        message(FATAL_ERROR "Linux 发布包须同时包含 XCB 和 Wayland 平台插件")
    endif()
endif()
